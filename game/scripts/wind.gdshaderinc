// Спільний вітер для трави, кущів і дерев.
//
// Слово замовника 11.09.2026: «невеличкий вітерець, який колихає
// різнотрав'я та дерева». Вітер — один на весь світ і з одного числа:
// трава й дерево в тій самій точці хиляться в той самий бік і в той
// самий момент. Було інакше — кожна рослина гойдалась своїм синусом, і
// ліс ворушився, як хор, а не під вітром.
//
// Пориви — плями шуму завширшки близько сорока метрів, що біжать за
// вітром зі швидкістю близько чотирьох метрів за секунду. Тому полем
// видно, як іде хвиля: трава лягає смугою, а за нею підводиться.

const vec2 WIND_DIR = vec2(0.8, 0.6);

float wind_hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float wind_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = wind_hash(i);
	float b = wind_hash(i + vec2(1.0, 0.0));
	float c = wind_hash(i + vec2(0.0, 1.0));
	float d = wind_hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// Сила вітру в точці: 0,25 — затишшя між поривами, 1,0 — порив.
float wind_gust(vec2 xz, float time) {
	vec2 p = xz / 38.0 - WIND_DIR * time * 0.11;
	float g = wind_noise(p) * 0.65 + wind_noise(p * 2.3 + 17.0) * 0.35;
	return 0.25 + 0.75 * smoothstep(0.30, 0.80, g);
}

// Куди й наскільки хилиться верхівка, у площині XZ світу. Довжина —
// до одиниці; скільки це метрів, вирішує той, хто кличе.
//
// `quick` — темп колихання поверх нахилу: трава тремтить часто, дерево
// гойдається повільно. Дві частоти, а не рівний синус: рівний читається
// як механізм.
//
// Нахил за поривом САМ ПО СОБІ оку майже не видно — видно коливання.
// Перша версія (11.09.2026) давала коливання лише ±0,1…0,45 від нахилу,
// і проба показала, що ялини рухались утричі менше, ніж зі старим
// синусом (3,5% пікселів за 1,5 с проти 10,1%). Тепер коливання
// ±0,35…0,8 поверх нахилу, і в затишші дерево не завмирає.
//
// Імена всередині — з префіксом `w_`, і це не прикраса. Спершу тут була
// локальна `sway`, а в `wind.gdshader` є uniform `sway` (розмах, 0,045):
// у деревах коливання множилось на нього замість ±1 і майже зникало.
// Проба А/Б (11.09.2026) на одній сцені: новий шейдер 3,2% пікселів за
// 1,5 с, старий 22,6%, а старий синус із новим переведенням — 24,8%.
// Трава рухалась нормально — у її шейдері uniform `sway` немає.
vec2 wind_push(vec2 xz, float time, float quick) {
	float w_gust = wind_gust(xz, time);
	float w_phase = dot(xz, vec2(0.31, 0.23));
	float w_wave = sin(time * quick + w_phase) * 0.6
			+ sin(time * quick * 2.3 + w_phase * 1.7) * 0.4;
	vec2 w_across = vec2(-WIND_DIR.y, WIND_DIR.x);
	float w_lean = w_gust * 0.55;
	float w_swing = w_wave * (0.35 + 0.45 * w_gust);
	// Вбік — майже стільки ж, скільки вздовж: крона ходить еліпсом.
	// Інакше, коли камера дивиться вздовж вітру, усе гойдання йде вглиб
	// кадру й оку його не видно.
	return WIND_DIR * (w_lean + w_swing)
			+ w_across * w_wave * 0.45 * (0.5 + 0.5 * w_gust);
}
