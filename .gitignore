# Службові файли Godot: кеш імпорту, налаштування редактора.
# Відновлюються самі при відкритті проєкту.
game/.godot/

# Локальні перевизначення налаштувань
game/override.cfg

# Складені збірки (tools/zibraty.sh кладе в build/)
build/
export/
# Версія збірки: tools/zibraty.sh кладе перед експортом і прибирає після
game/versiia.json

# Розпаковані паки моделей: у git не кладемо (див. game/моделі/ЯК-ДОДАТИ.md)
асети/
*.zip
.logs/

# Blender: резервні копії й кеш Python у tools/blender
*.blend1
__pycache__/

# Конвеєр 3D (tools/monster_pipeline.py): чернетки збірок і журнали завдань
art/monsters/*-3d/чернетка/
art/monsters/_завдання/
art/monsters/comfyui.log

# Лише гра й текст (слово замовника 26.09.2026): бінарні джерела моделей
# і картинки живуть тільки на диску. З тек видів — лише лог, стан і звіт.
art/monsters/*.blend
art/monsters/*-3d/*
!art/monsters/*-3d/*.md
!art/monsters/*-3d/*.json
art/monsters/_до-шаблону/

# Рухи Mixamo (Adobe): дозволено вживати в грі, не поширювати сирі файли — лише диск
art/mixamo/

# Старі версії ельфійки для переглядача (дістаються з git: git show <коміт>:<шлях>)
game/models/own/avatary/_arkhiv/
art/references/
*.до-розрізу

# Забраковані аватари (k1811, s808) — лише диск з 06.11.2026 (П6): у переглядачі є, у грі ні.
game/models/own/avatary/elf-k1811-mixamo/
game/models/own/avatary/elf-s808-mixamo/
*.до-русел

# Текстури дерев-велетів, вирізані з фото замовника (07.11.2026): чужі
# фото — лише на диску, доки замовник не вирішить. Без них дерево бере
# сірі матеріали (перевірка `ResourceLoader.exists`).
game/assets/baobab/
art/monsters/_аркуш-каркас/

# Каталог сервісу оновлень (tools/opublikuvaty.sh) — збірки клієнта, поза git
/updates/
