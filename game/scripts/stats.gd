class_name Stats
extends RefCounted
## Стати персонажа й усе, що з них рахується (крок 8 у П-52).
##
## Набір статів ПОГОДЖЕНО 02.09.2026 (П-37): п'ять замість шести в L2,
## із трьома правками — магічний захист у Витривалості, крит звичайним
## ударом у Спритності, Чуття зменшує чужий бонус за удар зі спини.
## Голих чисел бою більше ніде немає, тож баланс правиться тут.
##
## Числа у формулах — заглушки для налаштування. Підібрані так, щоб при
## усіх статах по 10 виходили ті самі значення, з якими гра жила до
## цього кроку: швидкість 5,0, відкат 1,2, здоров'я 100, зона бачення 18.
##
## Швидкості рахуються логарифмом, кількості — прямо (П-86): відкат і біг
## ніколи не впираються в межу, а здоров'я, атака й захист ростуть рівно.

## Значення, від якого рахується "звичайний" персонаж.
const AVERAGE := 10

## Українська назва стата -> поле тут (П-147): спільне для витрати очок
## (world.gd) і для збереження (store.gd), щоб назви не розходились.
const STAT_FIELDS := {
	"сила": "strength", "спритність": "agility", "витривалість": "stamina",
	"інтелект": "intellect", "чуття": "sense",
}

var strength := AVERAGE      ## Сила: фізична атака
var agility := AVERAGE       ## Спритність: швидкість руху й атаки
var stamina := AVERAGE       ## Витривалість: здоров'я, фізичний І магічний захист
var intellect := AVERAGE     ## Інтелект: мана, магічна атака
var sense := AVERAGE         ## Чуття: швидкість касту, зона бачення, захист від удару в спину

## Бафи («Стати персонажа», П-35): підвищують швидкість касту й знижують
## відкат. 0.0 — без бафів, 0.25 — на чверть коротший відкат.
##
## `cooldown_cut` — ЄДИНИЙ шлях, яким скорочується відкат скіла. Сюди
## пишуть бафи, дебафи, зброя та екіпіровка; **статів тут не буває**
## (П-35, П-37, підтверджено замовником 02.09.2026). Причина: стат на
## каст і стат на відкат разом дають подвійне множення, після якого маг
## на 70 рівні кастує вчетверо більше заклять за хвилину.
var cooldown_cut := 0.0
var cast_speed_bonus := 0.0
## Баф «концентрація уваги» (П-111): піднімає стійкість до перервання
## касту. 0.0 — без бафа, 0.5 — на половину більша концентрація.
var concentration_bonus := 0.0


## ── швидкості: логарифмічні (П-86, погоджено 02.09.2026) ──────────────
##
## Було віднімання: `1.8 - спритність * 0.06`. Воно впиралося в межу на
## статі 23, і далі стат не давав нічого взагалі.
##
## Стало: `основа - k * ln(стат / 10)`. Кожна наступна одиниця дає менше
## за попередню, але дає **завжди**; межі немає й на 70 рівні. При статі
## 10 виходять ті самі числа, з якими гра жила досі: біг 5,0, відкат
## 1,20, замах 0,35, каст 1,40.
##
## Коефіцієнти — ПРОПОЗИЦІЯ (числа в П-86), форма — рішення.
const SPEED_K := 0.60      ## біг
const COOLDOWN_K := 0.25   ## відкат удару
const SWING_K := 0.07      ## замах
const CAST_K := 0.30       ## читання заклять


## Наскільки стат вище за середній, у логарифмі. При 10 — рівно нуль.
static func growth(stat: int) -> float:
	return log(maxf(1.0, float(stat)) / float(AVERAGE))


func move_speed() -> float:
	return 5.0 + SPEED_K * growth(agility)


## Темп ЗВИЧАЙНИХ ударів — це швидкість фізичної атаки, і вона від стата
## (П-35: «темп задають стати, не кліки»). Не плутати з відкатом скіла:
## той рахується з поінтів скіла й статами не ріжеться взагалі.
func attack_cooldown() -> float:
	var base := 1.2 - COOLDOWN_K * growth(agility)
	return maxf(0.4, base * (1.0 - clampf(cooldown_cut, 0.0, 0.7)))


## Відкат скіла з його поінтів. Стата тут немає й не буде: ріжуть лише
## бафи, дебафи, зброя та екіпіровка через `cooldown_cut`.
func skill_cooldown(points: float) -> float:
	return maxf(0.2, points * (1.0 - clampf(cooldown_cut, 0.0, 0.7)))


## Час касту скіла з його поінтів. Оце вже ріже Чуття — через `cast_time`,
## яке при Чутті 10 дорівнює 1,4, тож множник виходить рівно 1,0.
func skill_cast(points: float) -> float:
	return maxf(0.1, points * 0.5 * (cast_time() / 1.4))


func swing_time() -> float:
	return maxf(0.15, 0.35 - SWING_K * growth(agility))


## Час читання заклять. Бафи на швидкість касту скорочують його.
func cast_time() -> float:
	var base := 1.4 - CAST_K * growth(sense)
	return maxf(0.2, base / (1.0 + maxf(0.0, cast_speed_bonus)))


func max_hp() -> int:
	return 40 + stamina * 6


func max_mp() -> int:
	return 20 + intellect * 5


func physical_attack() -> float:
	return 3.0 + strength * 0.4


## Магічна атака. Дзеркало фізичної: та від Сили, ця від Інтелекту.
## Числа — пропозиція (П-95): при Інтелекті 10 виходить рівно 7,0, тобто
## стільки ж, скільки фізична при Силі 10, і скіли можна порівнювати з
## ударом навпростець.
func magical_attack() -> float:
	return 3.0 + intellect * 0.4


func physical_defence() -> float:
	return stamina * 1.5


## Магічний захист — у Витривалості, а не в Чутті (П-37, правка 1).
## Інакше маг мусив однаково качати обидва свої стати, і вибору не було:
## Інтелект давав силу й ману, Чуття — швидкість, крит і захист.
func magical_defence() -> float:
	return stamina * 1.5


## Концентрація: наскільки важко збити тебе з касту (П-111).
##
## Росте від Чуття — того самого стата, що дає швидкість касту й
## сприйняття. Тобто маг, який качає Чуття, і читає швидше, і збивається
## рідше; а Витривалість дає магічний захист, який теж заважає збити.
## Дві різні дороги до однієї стійкості, як і в решті статів.
func concentration() -> float:
	return (10.0 + sense) * (1.0 + maxf(0.0, concentration_bonus))


## Шанс, що цей удар переб'є каст.
##
## Опір — це концентрація ПЛЮС магічний захист (П-111): захист можна
## підняти статами або екіпіровкою, і баф на нього теж рахується — саме
## тому він тут, а не окремою перевіркою.
##
## Множник 2,0 підібрано так, щоб звичайний удар 7 по магові зі статами
## по 10 (концентрація 20, магічний захист 15) давав 40%: каст 1,5 с
## переживає приблизно кожен другий раз.
const INTERRUPT_WEIGHT := 2.0
const INTERRUPT_MIN := 0.05
const INTERRUPT_MAX := 0.95


static func interrupt_chance(hit: int, guard: float) -> float:
	return clampf(hit * INTERRUPT_WEIGHT / maxf(1.0, guard),
			INTERRUPT_MIN, INTERRUPT_MAX)


## Скільки персонаж бачить (П-40). Дебафи на чутливість знижують `sense`,
## і разом із зоною стискається камера (П-47) та туман (П-65).
func vision_radius() -> float:
	return 12.0 + sense * 0.6


## Скільки шкоди дійде крізь захист. Захист не віднімається, а ділить:
## інакше при великому захисті шкода стала б нулем.
static func damage_through(attack: float, defence: float) -> int:
	return maxi(1, roundi(attack * 100.0 / (100.0 + defence)))


## Удар зі спини (П-40). Погоджено, що бонус є; самі числа — ПРОПОЗИЦІЯ
## П-85, чекає на слово замовника. Міняти тут.
const BACK_ARC_DEG := 120.0   ## Ширина заднього сектора.
const BACK_BONUS := 0.30      ## Наскільки більше шкоди звідти.


## Наскільки більше шкоди дійде ззаду ПО ЦІЙ жертві.
##
## Чуття зрізає чужу надбавку (П-37, правка 3): сприйняття природно
## захищає від удару в спину, і без цього Чуття фізикові ні до чого.
## Числа зрізання — ПРОПОЗИЦІЯ П-90: 3% надбавки за кожну одиницю Чуття
## понад середню, і не нижче чверті початкової. При Чутті 10 виходять ті
## самі 30%, з якими гра живе зараз.
const BACK_SENSE_CUT := 0.03
const BACK_BONUS_FLOOR := 0.25


static func back_bonus_against(victim: Stats) -> float:
	var cut := 1.0 - (victim.sense - AVERAGE) * BACK_SENSE_CUT
	return BACK_BONUS * clampf(cut, BACK_BONUS_FLOOR, 1.0)


## Чи стоїть нападник у задньому секторі жертви.
##
## Кут між тим, куди дивиться жертва, і напрямком на нападника має бути
## більшим за 180° - BACK_ARC_DEG/2. При секторі 120° це 120°, тобто
## скалярний добуток менший за -0,5.
static func from_behind(victim_facing: float, victim_pos: Vector3,
		attacker_pos: Vector3) -> bool:
	var to_attacker := attacker_pos - victim_pos
	to_attacker.y = 0.0
	if to_attacker.length_squared() < 0.0001:
		return false
	# Куди дивиться жертва: -Z вузла, повернуте на її кут.
	var forward := Vector3(-sin(victim_facing), 0.0, -cos(victim_facing))
	var edge := cos(deg_to_rad(180.0 - BACK_ARC_DEG * 0.5))
	return forward.dot(to_attacker.normalized()) < edge
