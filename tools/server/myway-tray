#!/usr/bin/env bash
# Значок «MyWay — сервер» у треї. Electron — той самий, що в «Марса» й «Відеокарти».
#   tools/server/myway-tray                запустити значок
#   tools/server/myway-tray --автозапуск   ще й ставити його при вході в систему
root="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
electron="${MYWAY_TRAY_ELECTRON:-$HOME/voice-assistant-panel/node_modules/electron/dist/electron}"
[ -x "$electron" ] || { echo "немає Electron: $electron (задайте MYWAY_TRAY_ELECTRON)" >&2; exit 1; }
if [ "${1:-}" = "--автозапуск" ]; then
    mkdir -p "$HOME/.config/autostart"
    cat > "$HOME/.config/autostart/myway-server-tray.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=MyWay — сервер (значок у треї)
Comment=Запуск, зупинка й оновлення сервера гри MyWay, онлайн
Exec=$root/myway-tray
Icon=applications-games
Terminal=false
Categories=Game;Utility;
X-GNOME-Autostart-enabled=true
EOF
    echo "✓ автозапуск: ~/.config/autostart/myway-server-tray.desktop"
    shift
fi
nohup "$electron" "$root/tray/main.js" --no-sandbox "$@" >/dev/null 2>&1 &
disown
