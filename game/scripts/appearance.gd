		["червоний", Color(0.62, 0.12, 0.1)], ["рудий", Color(0.8, 0.38, 0.16)],
		["каштановий", Color(0.36, 0.21, 0.12)], ["чорний", Color(0.1, 0.09, 0.09)],
		["білий", Color(1, 1, 1)]]
