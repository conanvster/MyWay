		["зелені", Color(0.3, 0.65, 0.35)], ["сірі", Color(0.55, 0.6, 0.65)],
		["бурштинові", Color(0.85, 0.55, 0.15)], ["фіалкові", Color(0.55, 0.35, 0.85)],
		["червоні", Color(0.8, 0.1, 0.1)], ["карі", Color(0.35, 0.2, 0.1)]]
const LIPS := [["як є", null], ["рожеві", Color(0.85, 0.5, 0.55)],
		["ягідні", Color(0.55, 0.15, 0.3)], ["червоні", Color(0.75, 0.1, 0.12)],
		["бліді", Color(0.82, 0.66, 0.62)]]
const SKIN := [["як є", null], ["місячно-бліда", Color(0.88, 0.86, 0.85)],
		["світла", Color(0.86, 0.72, 0.64)], ["смаглява", Color(0.7, 0.52, 0.4)],
		["бронзова", Color(0.55, 0.38, 0.26)], ["оливкова", Color(0.68, 0.6, 0.45)],
		["сіро-блакитна", Color(0.55, 0.6, 0.7)], ["попелясто-сіра", Color(0.5, 0.5, 0.52)],
		# орки з вікі: «muted olive green-brown skin»
		["оливково-зелена", Color(0.46, 0.5, 0.3)], ["болотяна", Color(0.36, 0.42, 0.26)]]
const LINER := [["немає", 0.0], ["легка", 0.45], ["темна", 0.85]]
## Кольорові вибори: ключ збереження → [палітра, ключ `SkinnedModel.customize`].
const COLOURS := {
	"волосся": [HAIR, "колір_волосся"],
	"очі": [EYES, "колір_очей"],
	"губи": [LIPS, "колір_губ"],
	"шкіра": [SKIN, "колір_шкіри"],
}
## Риси (форм-ключі `Ніс-…`, `Губи-…`, `Очі-…`, `Вуха-…`): ключ
## збереження → ключ `customize`.
const SHAPES := {"ніс": "ніс", "губи_форма": "губи", "очі_форма": "очі",
		"вуха": "вуха"}
const VARIANTS := 3

## Аватари зі сканів на скелеті Mixamo: «раса-стать» → модель на кожен
## варіант. Варіанта ще немає (скан не зроблено) — береться перший, і
## екран створення каже про це чесно (`ready_variants`).
const SCAN_DIR := "res://models/own/avatary/"
const SCANS := {
	"орк-жінка": [SCAN_DIR + "ork-s1303-mixamo/ork-s1303-mixamo.glb"],
	"ельф-жінка": [SCAN_DIR + "elf-e1903-mixamo/elf-e1903-mixamo.glb"],
	"людина-жінка": [SCAN_DIR + "lyud-l2002-mixamo/lyud-l2002-mixamo.glb"],
}


## Три варіанти кожного типу — з розділу «Раси» вікі (`wiki/rasy.html`,
## кадри `wiki/img/rasy/<тип>-v1..v3.png`; у грі — мініатюри
## `assets/rasy/`). Поки на тип один скан, варіант — це зачіска, кольори
## й риси, підібрані під кадр (П-280, рекомендація). Гравець потім може
## змінити будь-що з цього. Зачіски й риси — назви з моделей:
## жінки-скани мають зачіски «зачесане/каре/коса/коси/пряме» (орчиха —
## «коси/пряме»), риси ніс/губи/очі/вуха — лише ельфійка й людина.
const PRESETS := {
	"людина-жінка": [
		# довге пряме каштанове, карі очі
		{"зачіска": "пряме", "волосся": "каштановий", "очі": "карі",
				"ніс": "вузький"},
		# чорне, зібране в косу; смаглява, мигдалеві очі
		{"зачіска": "коса", "волосся": "чорний", "очі": "карі",
				"шкіра": "смаглява", "очі_форма": "мигдалеві",
				"ніс": "кирпатий"},
		# темне, зачесане назад; світла, сірі очі
		{"зачіска": "зачесане", "волосся": "чорний", "очі": "сірі",
				"шкіра": "світла", "губи_форма": "тонкі",
				"ніс": "з-горбинкою"},
	],
	"ельф-жінка": [
		# довге пряме біле, малі гострі вуха, вузьке обличчя
		{"зачіска": "пряме", "волосся": "білий", "очі": "блакитні",
				"шкіра": "місячно-бліда", "вуха": "підняті", "ніс": "вузький",
				"очі_форма": "вузькі"},
		# коротко зачесане солом'яне, довгі вуха
		{"зачіска": "зачесане", "волосся": "солом'яний", "очі": "зелені",
				"шкіра": "світла", "вуха": "довгі", "очі_форма": "великі"},
		# довге сиве, мигдалеві очі, тонкі губи
		{"зачіска": "пряме", "волосся": "сивий", "очі": "сірі",
				"шкіра": "місячно-бліда", "вуха": "короткі",
				"очі_форма": "мигдалеві", "губи_форма": "тонкі"},
	],
	"орк-жінка": [
		# чорні коси, бурштинові очі
		{"зачіска": "коси", "волосся": "чорний", "очі": "бурштинові",
				"шкіра": "оливково-зелена"},
		# чорні коси, ягідні губи, червоні очі
		{"зачіска": "коси", "волосся": "чорний", "очі": "червоні",
				"губи": "ягідні", "шкіра": "оливкова"},
		# чорне пряме зачесане назад, підводка
		{"зачіска": "пряме", "волосся": "чорний", "очі": "карі",
				"підводка": "темна", "шкіра": "болотяна"},
	],
	# Чоловіків-сканів ще немає (П-257): лише кольори з кадрів, щоб вибір
	# зберігся і ожив, щойно скан з'явиться.
	"людина-чоловік": [{"волосся": "каштановий", "очі": "карі"},
			{"волосся": "чорний", "очі": "сірі"},
			{"волосся": "чорний", "очі": "карі"}],
	"ельф-чоловік": [{"волосся": "білий", "очі": "блакитні"},
			{"волосся": "сивий", "очі": "сірі"},
			{"волосся": "солом'яний", "очі": "зелені"}],
	"орк-чоловік": [{"волосся": "чорний", "очі": "бурштинові", "шкіра": "оливково-зелена"},
			{"волосся": "чорний", "очі": "червоні", "шкіра": "болотяна"},
			{"волосся": "чорний", "очі": "карі", "шкіра": "оливкова"}],
}
const PICTURE := "res://assets/rasy/%s-%s-%d.jpg"
const LATIN := {"людина": "lyudyna", "орк": "ork", "ельф": "elf",
		"чоловік": "cholovik", "жінка": "zhinka"}


static func kind_of(race: String, sex: String) -> String:
	return "%s-%s" % [race, "жінка" if sex == "жінка" else "чоловік"]


## Скільки варіантів цього типу можна показати моделлю: є скан — усі
## три (варіант = набір рис на ньому), немає — жодного.
static func ready_variants(race: String, sex: String) -> int:
	return VARIANTS if SCANS.has(kind_of(race, sex)) else 0


## Зовнішність варіанта з кадру вікі (назви, як у збереженні).
static func preset(race: String, sex: String, variant: int) -> Dictionary:
	var list: Array = PRESETS.get(kind_of(race, sex), [])
	var out := {"варіант": clampi(variant, 1, VARIANTS)}
	if variant >= 1 and variant <= list.size():
		out.merge(list[variant - 1], true)
	return out


## Мініатюра кадру вікі для картки варіанта.
static func picture(race: String, sex: String, variant: int) -> String:
	var who := "жінка" if sex == "жінка" else "чоловік"
	return PICTURE % [LATIN.get(race, race), LATIN[who], variant]


## Модель для варіанта; порожньо — скану цього типу немає. Окремого скану
## на варіант ще немає — береться перший.
static func model_of(race: String, sex: String, variant: int) -> String:
	var list: Array = SCANS.get(kind_of(race, sex), [])
	if list.is_empty():
		return ""
	return str(list[clampi(variant - 1, 0, list.size() - 1)])


static func names_of(palette: Array) -> Array:
	var out: Array = []
	for row: Array in palette:
		out.append(row[0])
	return out


static func _colour(palette: Array, name: String) -> Variant:
	for row: Array in palette:
		if row[0] == name:
			return row[1]
	return null


## Сервер: лишити тільки відомі ключі й назви з палітр. Зачіску й риси
## перевіряє клієнт за моделлю (сервер моделей не вантажить): невідома
## назва там просто нічого не міняє.
static func clean(raw: Variant) -> Dictionary:
	var out := {"варіант": 1}
	if not raw is Dictionary:
		return out
	var d: Dictionary = raw
	out["варіант"] = clampi(int(d.get("варіант", 1)), 1, VARIANTS)
	for key: String in COLOURS:
		var name := str(d.get(key, ""))
		if name in names_of(COLOURS[key][0]):
			out[key] = name
	var liner := str(d.get("підводка", ""))
	if liner in names_of(LINER):
		out["підводка"] = liner
	for key: String in ["зачіска"] + SHAPES.keys():
		var v := str(d.get(key, "")).strip_edges()
		if v != "" and v.length() <= 32:
			out[key] = v
	return out


## Збережене (назви) → словник для `SkinnedModel.customize` (кольори).
static func to_look(saved: Dictionary) -> Dictionary:
	var look := {}
	for key: String in COLOURS:
		if saved.has(key):
			look[COLOURS[key][1]] = _colour(COLOURS[key][0], str(saved[key]))
	if saved.has("підводка"):
		look["підводка"] = float(_colour(LINER, str(saved["підводка"])))
	if saved.has("зачіска"):
		look["зачіска"] = str(saved["зачіска"])
	for key: String in SHAPES:
		if saved.has(key):
			look[SHAPES[key]] = str(saved[key])
	return look
