#!/usr/bin/env bash
# Гачок перед комітом: швидка перевірка (лінтер, сервер, стартова
# сторінка) — близько хвилини.
#
# Ставиться раз на репозиторій:
#     git config core.hooksPath hooks
#
# Обійти, коли справді треба:
#     git commit --no-verify
#
# Чому саме ці три кроки. Вада, через яку сторінка не бачила сервера,
# коштувала чотирьох годин і не ловилась нічим: код компілювався, проби
# проходили, а ламалось на стику процесів. Тому гачок ганяє СПРАВЖНІ
# сервер і клієнт. Бій і картинку сюди не беремо — вони довгі й хочуть
# екрана; для них є повний `./check.sh`.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! command -v godot > /dev/null; then
    echo "‼ godot не знайдено — перевірку пропущено" >&2
    exit 0
fi

./check.sh --швидко
code=$?
if [ $code -ne 0 ]; then
    echo
    echo "‼ коміт зупинено: перевірка не пройшла." >&2
    echo "  полагодь або, якщо певен, — git commit --no-verify" >&2
fi
exit $code
